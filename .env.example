# Copy values into your shell environment; this file is not automatically loaded.
# Set provider=gemini for real interview extraction.
M2_LLM_PROVIDER=mock
GEMINI_API_KEY=
# Stable Gemini model with structured output and a free tier.
GEMINI_MODEL=gemini-3.6-flash
M2_LLM_TIMEOUT_SECONDS=30
M2_MAX_TURNS=40
M2_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
