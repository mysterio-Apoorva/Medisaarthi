# Same-origin proxy keeps session cookies working on localhost and 127.0.0.1.
NEXT_PUBLIC_API_BASE_URL=/api
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_VAD_ENABLED=true
NEXT_PUBLIC_SILENCE_THRESHOLD=0.014
NEXT_PUBLIC_MIN_SPEECH_DURATION=220
NEXT_PUBLIC_END_OF_SPEECH_DELAY=2800
NEXT_PUBLIC_NO_SPEECH_TIMEOUT=18000
