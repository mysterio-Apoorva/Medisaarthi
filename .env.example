# The backend loads this file automatically. Use Gemini for the real application path.
M2_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
M2_LLM_TIMEOUT_SECONDS=30
M2_MAX_TURNS=40
M2_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Omit for the default workspace-local data/medisaarthi.db.
MEDISAARTHI_DB_PATH=
