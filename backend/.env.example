# Zero-config local persistence. Use an absolute path in production.
MEDIKIOSK_DB_PATH=backend/data/medikiosk.sqlite3

# AI is optional. With Ollama unavailable, MediKiosk continues using the
# explicitly labelled deterministic clinical-rules provider.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b-instruct
AI_FALLBACK_MODELS=
AI_SUMMARY_TIMEOUT=75
ALLOW_EXTERNAL_AI=false
EMBEDDING_MODEL=all-minilm
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Browser origin(s) allowed to send authenticated cookies to this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
DOCUMENT_UPLOAD_DIR=backend/data/uploads
# Local faster-whisper configuration. `base` is multilingual and CPU-friendly.
STT_MODEL=base
STT_MODEL_HI=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MODEL_DIR=backend/data/models
STT_MIN_AVG_LOGPROB=-1.0
STT_MAX_NO_SPEECH_PROB=0.6
# Download with: python -m piper.download_voices en_US-lessac-medium hi_IN-pratham-medium --download-dir backend/data/tts
TTS_MODEL_EN=backend/data/tts/en_US-lessac-medium.onnx
TTS_MODEL_HI=backend/data/tts/hi_IN-pratham-medium.onnx
LOG_LEVEL=INFO

# Synthetic demo credentials only. Change before any shared demonstration.
DEMO_PASSWORD=DemoPass!2026

# Optional future/live integration endpoints. They are not used by development adapters.
FHIR_BASE_URL=
ABDM_BASE_URL=
HIS_BASE_URL=
