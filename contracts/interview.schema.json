{
  "$defs": {
    "ClinicalState": {
      "additionalProperties": false,
      "properties": {
        "chief_complaint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chief Complaint"
        },
        "hpi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hpi"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "severity": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "breathlessness": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breathlessness"
        },
        "breathlessness_onset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breathlessness Onset"
        },
        "cough": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cough"
        },
        "sudden_onset": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sudden Onset"
        },
        "vomiting": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vomiting"
        },
        "past_medical_history": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Past Medical History"
        },
        "medications": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medications"
        },
        "allergies": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allergies"
        },
        "family_history": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family History"
        },
        "personal_history": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Personal History"
        }
      },
      "title": "ClinicalState",
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 30,
          "title": "Facts",
          "type": "array"
        },
        "uncertain_fields": {
          "items": {
            "enum": [
              "chief_complaint",
              "hpi",
              "duration",
              "severity",
              "location",
              "temperature",
              "breathlessness",
              "breathlessness_onset",
              "cough",
              "sudden_onset",
              "vomiting",
              "past_medical_history",
              "medications",
              "allergies",
              "family_history",
              "personal_history"
            ],
            "type": "string"
          },
          "title": "Uncertain Fields",
          "type": "array"
        }
      },
      "title": "Extraction",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "chief_complaint",
            "hpi",
            "duration",
            "severity",
            "location",
            "temperature",
            "breathlessness",
            "breathlessness_onset",
            "cough",
            "sudden_onset",
            "vomiting",
            "past_medical_history",
            "medications",
            "allergies",
            "family_history",
            "personal_history"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "status": {
          "enum": [
            "reported",
            "unknown",
            "declined"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "status",
        "evidence"
      ],
      "title": "Fact",
      "type": "object"
    },
    "NextQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "chief_complaint",
            "hpi",
            "duration",
            "severity",
            "location",
            "temperature",
            "breathlessness",
            "breathlessness_onset",
            "cough",
            "sudden_onset",
            "vomiting",
            "past_medical_history",
            "medications",
            "allergies",
            "family_history",
            "personal_history"
          ],
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "hi"
          ],
          "title": "Language",
          "type": "string"
        },
        "clarification": {
          "default": false,
          "title": "Clarification",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "language"
      ],
      "title": "NextQuestion",
      "type": "object"
    },
    "Symptom": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "present": {
          "default": true,
          "title": "Present",
          "type": "boolean"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "severity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        }
      },
      "required": [
        "name"
      ],
      "title": "Symptom",
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "title": "Turn Id",
          "type": "integer"
        },
        "question": {
          "$ref": "#/$defs/NextQuestion"
        },
        "original_statement": {
          "title": "Original Statement",
          "type": "string"
        },
        "extraction": {
          "$ref": "#/$defs/Extraction"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "question",
        "original_statement",
        "extraction"
      ],
      "title": "Turn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "interview_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Interview Id",
      "type": "string"
    },
    "patient_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Patient Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "hi"
      ],
      "title": "Language",
      "type": "string"
    },
    "consent": {
      "const": true,
      "title": "Consent",
      "type": "boolean"
    },
    "consent_recorded_at": {
      "format": "date-time",
      "title": "Consent Recorded At",
      "type": "string"
    },
    "clinical_state": {
      "$ref": "#/$defs/ClinicalState"
    },
    "chief_complaint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chief Complaint"
    },
    "symptoms": {
      "items": {
        "$ref": "#/$defs/Symptom"
      },
      "title": "Symptoms",
      "type": "array"
    },
    "responses": {
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "title": "Responses",
      "type": "array"
    },
    "completed": {
      "default": false,
      "title": "Completed",
      "type": "boolean"
    },
    "completion_reason": {
      "anyOf": [
        {
          "enum": [
            "collected",
            "patient_requested",
            "turn_limit"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Reason"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "revision": {
      "default": 0,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "interview_id",
    "patient_id",
    "language",
    "consent"
  ],
  "title": "Interview",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
